# Production environment template for Railway
# Copy and set these as Railway environment variables -- do NOT commit real values.

# Database (Supabase PostgreSQL connection string)
DATABASE_URL=postgresql+psycopg2://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Auth -- MUST be a unique, long random string in production
JWT_SECRET=CHANGE-ME-generate-with-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS -- your Vercel domain(s), never a wildcard
CORS_ORIGINS=https://your-app.vercel.app

# Image storage -- Supabase Storage in production
IMAGE_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJ...
SUPABASE_STORAGE_BUCKET=product-images

# Not used in production (Supabase handles images), but must be set to avoid errors
UPLOAD_DIR=uploads
API_BASE_URL=https://your-backend.up.railway.app

# Customer-facing catalog URL (the Vercel frontend)
CATALOG_BASE_URL=https://your-app.vercel.app

# Razorpay Subscriptions (Phase 5). Test-mode keys are fine to start.
# Key ID + Secret: Razorpay Dashboard -> Settings -> API Keys.
# Webhook secret: Dashboard -> Settings -> Webhooks -> add
#   https://<backend>/api/webhooks/razorpay  with events:
#   subscription.activated, subscription.charged, subscription.pending,
#   subscription.halted, subscription.cancelled, subscription.completed
# Leave blank to run without billing (trials + manual overrides still work).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# App
APP_NAME=Digital Catalog SaaS API
APP_VERSION=1.0.0
ENVIRONMENT=production
